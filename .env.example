# Server Configuration
PORT=3001
HOST=localhost
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=*

# Security Configuration
HELMET_ENABLED=true
RATE_LIMIT_ENABLED=false

# Speed Test Configuration
MAX_UPLOAD_SIZE=100
DEFAULT_DOWNLOAD_SIZE=10
DEFAULT_UPLOAD_SIZE=5
PING_MEASUREMENTS=5
PING_INTERVAL=200

# Logging Configuration
LOG_LEVEL=info
LOGGING_ENABLED=true
